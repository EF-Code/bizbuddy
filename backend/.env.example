# All optional: the app runs with a local SQLite database and key-free replies.
PUBLIC_API_URL=https://bizbuddy.naijatown.app
# Generate once; keep it stable, private and backed up.
CHATBOT_ENCRYPTION_KEY=
# Optional existing OpenAI integration; leaving this blank uses grounded replies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional MySQL override; default is backend/bizbuddy.db.
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/bizbuddy
# Optional official Meta integrations:
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v24.0
