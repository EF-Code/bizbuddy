OPENAI_API_KEY=replace_with_your_own_key
OPENAI_MODEL=gpt-4o-mini
# For an OpenAI-compatible provider (including a compatible OpenCode endpoint):
# OPENAI_BASE_URL=https://your-provider.example/v1
# Use that provider's API key and exact model ID above.
CHATBOT_ENCRYPTION_KEY=generate_a_fernet_key_and_keep_it_secret
PUBLIC_API_URL=https://api.example.com
META_WEBHOOK_VERIFY_TOKEN=choose_a_long_random_verification_token
META_GRAPH_API_VERSION=v24.0

# Keyless OpenCode CLI transport (install the CLI inside the backend container).
# Set AI_PROVIDER=opencode to select it; free-model limits still apply.
AI_PROVIDER=openai
OPENCODE_BIN=opencode
OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free
